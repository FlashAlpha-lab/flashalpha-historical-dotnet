<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <RootNamespace>FlashAlpha.Historical</RootNamespace>

    <PackageId>FlashAlpha.Historical</PackageId>
    <Version>0.4.0-rc.4</Version>
    <Authors>FlashAlpha</Authors>
    <Company>FlashAlpha</Company>
    <Description>Official .NET SDK for the FlashAlpha Historical API — point-in-time replay of GEX, gamma flip, VRP, narrative, max pain, 0DTE, and the full stock summary at any minute back to 2018-04-16. Backtest options strategies against 6.7B+ option rows.</Description>
    <PackageTags>options options-backtest historical-options gamma-exposure gex greeks options-analytics implied-volatility 0dte volatility-surface vrp variance-risk-premium svi point-in-time replay backtesting flashalpha-historical</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://historical.flashalpha.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FlashAlpha-lab/flashalpha-historical-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 FlashAlpha</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
